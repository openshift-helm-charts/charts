{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Zainar LCS Helm values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "env": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "Never", "IfNotPresent"]
        },
        "imageRegistry": { "type": "string" },
        "waitImage": { "$ref": "#/$defs/image" },
        "waitForLoki": { "type": "boolean" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" }
            }
          }
        }
      }
    },
    "registrySecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "server": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "externalSecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "targetSecretName": { "type": "string" }
      }
    },
    "secretEnv": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "db": { "$ref": "#/$defs/component" },
    "controller": { "$ref": "#/$defs/component" },
    "lmfPe": { "$ref": "#/$defs/component" },
    "lcsTestFramework": { "$ref": "#/$defs/component" },
    "amfProxy": { "$ref": "#/$defs/component" },
    "zpsLight": { "$ref": "#/$defs/component" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "role": { "type": "string" },
        "persistence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "image": { "$ref": "#/$defs/image" },
        "resources": { "type": "object" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
